# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key   # server only, never in front-end code

# Geofence (optional). Set GEOFENCE_ENABLED=true to enforce it on the server.
GEOFENCE_ENABLED=false
WORK_LAT=13.7563
WORK_LNG=100.5018
WORK_RADIUS_METERS=150
